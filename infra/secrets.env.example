# Copy this file to infra/secrets.env and fill in your keys.
# infra/secrets.env is gitignored — it never gets committed.
# deploy.sh reads these and stores them in AWS SSM Parameter Store (SecureString);
# the keys are never written into the CloudFormation template or Lambda env vars.

# Twelve Data — https://twelvedata.com/  (free tier: 800 calls/day, 8/min)
TWELVEDATA_API_KEY=

# Groq — https://console.groq.com/  (free tier; OpenAI-compatible Chat Completions)
# Used to classify new posts (openai/gpt-oss-20b primary, gpt-oss-120b fallback on 429).
GROQ_API_KEY=
